{
  "rewrites": [
    {
      "source": "/questions",
      "destination": "/api/seo?route=questions"
    },
    {
      "source": "/questions/:idSlug",
      "destination": "/api/seo?route=question&idSlug=:idSlug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?route=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo?route=robots"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/seo?route=llms"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/seo?route=llms-full"
    },
    {
      "source": "/answers.json",
      "destination": "/api/seo?route=answers-json"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
